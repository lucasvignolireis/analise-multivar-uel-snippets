library(mdatools)
library(magrittr)
library(ggplot2)
library(readxl)
library(xlsx)
Xcal <- read_excel("./Xcal.xlsx") %>% as.data.frame()
Xcal
summary(Xcal)
Xcal <- read_excel("./Xcal.xlsx") as.data.frame()
Ycal <- read_excel("D:/MESTRADO/tutoriais R/dados para aulas/plsda/Ycal.xlsx") %>% as.matrix()
Ycal <- read_excel("./Ycal.xlsx") %>% as.matrix()
Xpred <- read_excel("./Xpred.xlsx") %>% as.data.frame()
Ypred <- read_excel("./Ypred.xlsx") %>% as.matrix()
row.names(Xcal) <- Xcal$Amostras
row.names(Xpred) <- Xpred$Amostras
Xcal <- Xcal[,-1]
Xpred <- Xpred[,-1]
as.factor(Ycal)
as.factor(Ypred)
Ycal.logico <- Ycal == "LV"
Ypred.logico <- Ypred == "LV"
show(Ycal.logico)#verificar
help(plsda)
plsda <- plsda(Xcal, Ycal.logico, 9, cv = 10, classname = "LV")#modelo com uma classe
plotRMSE(plsda)#para escolher o numero de LV
plotSensitivity(plsda)
plotSpecificity(plsda)
summary(plsda)#resumo do modelo
Sen_cal <- plsda[["calres"]][["sensitivity"]] %>% as.data.frame()
Sen_cal <- data.frame(Sen=Sen_cal[1,9])
Sel_cal <- plsda[["calres"]][["specificity"]] %>% as.data.frame()
Sel_cal <- data.frame(Sel=Sel_cal[1,9])
VP_cal <- plsda[["calres"]][["tp"]] %>% as.data.frame()
VP_cal <- data.frame(VP=VP_cal[,9])
FP_cal <- plsda[["calres"]][["fp"]] %>% as.data.frame()
FP_cal <- data.frame(FP=FP_cal[,9])
VN_cal <- plsda[["calres"]][["tn"]] %>% as.data.frame()
VN_cal <- data.frame(VN=VN_cal[,9])
FN_cal <- plsda[["calres"]][["fn"]] %>% as.data.frame()
FN_cal <- data.frame(FN=FN_cal[,9])
#matriz de confusao
getConfusionMatrix(plsda$calres)
Matriz_Conf_Cal <- getConfusionMatrix(plsda$calres) %>% as.data.frame()
#calculando alguns parametros 
#Taxa de Falso Positivo (TFP)
TFP_cal <- (FP_cal*100)/(FP_cal+VN_cal)
TFP_cal
colnames(TFP_cal) <- "TFP"
#Taxa de Falso Negativo (TFN)
TFN_cal <- (FN_cal*100)/(FN_cal+VP_cal)
TFN_cal
colnames(TFN_cal) <- "TFN"
#Taxa de Confiabilidade (TCONF)
TCONF_cal <- 100-(TFP_cal+TFN_cal)
TCONF_cal
colnames(TCONF_cal) <- "TCONF"
[200~plotXVariance(plsda)
plotXVariance(plsda)
plotXCumVariance(plsda)
plotYVariance(plsda)
plotYCumVariance(plsda)
plotYVariance(plsda)
RMSECV <- plsda[["cvres"]][["rmse"]] %>%  t() %>%  as.data.frame()
RMSECV
CVR2 <- plsda[["cvres"]][["r2"]] %>%  t() %>%  as.data.frame()
CVR2
#extraindo valores da calibração
RMSEC <- plsda[["calres"]][["rmse"]] %>%  t() %>%  as.data.frame()
RMSEC
CalR2 <- plsda[["calres"]][["r2"]] %>%  t() %>%  as.data.frame()
CalR2
VarExplX <- plsda[["calres"]][["xdecomp"]][["expvar"]] %>% as.data.frame()
VarExplY <- plsda[["calres"]][["ydecomp"]][["expvar"]] %>% as.data.frame()
#coeficientes de regressão
summary(plsda$coeffs)  
plotRegcoeffs(plsda, type = "l", 
              show.ci = FALSE, 
              alpha= 0.05, 
              show.labels = FALSE)#tipos l=linha, ou h=altura
vet_reg <- plsda[["coeffs"]][["values"]] %>% as.data.frame()
colnames(vet_reg) <- c("LV1", "LV2", "LV3", "LV4", "LV5", "LV6", "LV7", "LV8", "LV9")
ggplot(vet_reg, aes(x=as.numeric(row.names(vet_reg)),y=LV9))+ 
  geom_line(linewidth=0.8, colour = "darkblue") + 
  geom_hline(yintercept = 0, linetype="dashed") +
  theme_classic() +
  theme(legend.position = "right", 
        text = element_text(size=16, family = "serif"),
        axis.line = element_line(colour = "black"), 
        axis.text = element_text(color = "black"),
        axis.ticks = element_line(colour = "black"),
        plot.title = element_text(size = 20, 
                                  face = "bold", 
                                  hjust = 0.5)) +
  scale_x_continuous(name = "Energia (keV)", 
                     limits = c(1, 16), 
                     breaks = seq(0, 40, by = 1)) + 
  scale_y_continuous(name = "LV 8", 
                     breaks = seq(-1, 2, by = 0.25))+
  ggtitle("Vetor de Regressão")
plotVIPScores(plsda)#vipscores_cal
#extraindo
VIPScores <- vipscores(plsda) %>% as.data.frame()
ggplot(VIPScores, aes(x=as.numeric(row.names(VIPScores)))) + 
  geom_line(aes(y=LV), linewidth=0.9, col="red")+
  geom_vline(xintercept = 0, 
             linetype="dashed") + 
  geom_hline(yintercept = 0, 
             linetype="dashed") +
  theme_classic()+
  theme(legend.position = "top", 
        text = element_text(size=18, family = "serif"),
        axis.line = element_line(colour = "black"), 
        axis.text = element_text(color = "black"),
        axis.ticks = element_line(colour = "black")) +
  scale_x_continuous(name = "Energia (keV)", 
                     breaks = seq(0, 40, by = 1)) + 
  scale_y_continuous(name = "VIPScores", 
                     breaks = seq(-10, 10, by = 0.5)) 
ycalresults$classificacao <- ifelse(
  ycalresults$Ycal > 0 & ycalresults$Yreferencia == 1,
  "Verdadeiro Positivo - LV",
  ifelse(
    ycalresults$Ycal > 0 & ycalresults$Yreferencia == -1,
    "Falso Positivo - LV",
    ifelse(
      ycalresults$Ycal < 0 & ycalresults$Yreferencia == -1,
      "Verdadeiro Negativo - LV",
      ifelse(
        ycalresults$Ycal < 0 & ycalresults$Yreferencia == 1,
        "Falso Negativo - LV",
        NA # caso não se encaixe em nenhuma regra
      )
    )
  )
)
ycalresults <- plsda[["calres"]][["y.pred"]] %>% as.data.frame()
ycalresults <- ycalresults[,9] %>% as.data.frame()
ycalresults$amostras <- row.names(Xcal)
colnames(ycalresults)[1] <- "Ycal"
ycalresults$amostras <- as.numeric(ycalresults$amostras)
ycalresults <- ycalresults[,c("amostras", "Ycal")]
#adicionando os valores de yreferencia em calresults
ycalref <- plsda[["calres"]][["y.ref"]] %>% as.data.frame()
colnames(ycalref) <- "Yreferencia"
ycalresults <- data.frame(ycalresults, ycalref)
Classe_cal <- Ycal#usando as classes de Ycal para rotular os pontos no grafico
ggplot(ycalresults, aes(x=amostras, y=Ycal)) +
  geom_point(aes(colour=Classe_cal, 
                 shape=Classe_cal), 
             size=4) +
  scale_shape_manual(values = c(8,20)) +
  scale_color_manual(values = c("red", "darkblue")) +
  geom_hline(yintercept = 0, 
             linetype="dashed", 
             color="green", 
             linewidth=1) +
  theme_classic( ) +
  theme(legend.position = "top", 
        text = element_text(size=18,
                            family = "serif"),
        axis.line = element_line(colour = "black"),
        axis.text.x = element_text(color = "black"), 
        axis.text.y = element_text(color = "black")) +
  labs(x="Amostras", 
       y= "Yprevisto - Cal")+
  scale_y_continuous(breaks=seq(-2, 1.5, 0.5))
ycalresults$classificacao <- ifelse(
  ycalresults$Ycal > 0 & ycalresults$Yreferencia == 1,
  "Verdadeiro Positivo - LV",
  ifelse(
    ycalresults$Ycal > 0 & ycalresults$Yreferencia == -1,
    "Falso Positivo - LV",
    ifelse(
      ycalresults$Ycal < 0 & ycalresults$Yreferencia == -1,
      "Verdadeiro Negativo - LV",
      ifelse(
        ycalresults$Ycal < 0 & ycalresults$Yreferencia == 1,
        "Falso Negativo - LV",
        NA # caso não se encaixe em nenhuma regra
      )
    )
  )
)
Resumo_FOM_cal <- data.frame(VP_cal, 
                             VN_cal, 
                             FP_cal, 
                             FN_cal, 
                             Sen_cal, 
                             Sel_cal,
                             TFP_cal, 
                             TFN_cal, 
                             TCONF_cal)
############################ VALIDACAO #################################################
plsda_pred <- predict(plsda, Xpred, Ypred.logico, classname = "LV")
summary(plsda_pred)#resumo
plotRMSE(plsda_pred)
plotSensitivity(plsda_pred)
plotSpecificity(plsda_pred)
#extraindo valores
Sen_pred <- plsda[["calres"]][["sensitivity"]] %>% as.data.frame()
Sen_pred <- data.frame(Sen=Sen_pred[1,9])
Sel_pred <- plsda[["calres"]][["specificity"]] %>% as.data.frame()
Sel_pred <- data.frame(Sel=Sel_pred[1,9])
plotRMSE(plsda_pred)
plotSensitivity(plsda_pred)
plotSpecificity(plsda_pred)
plotRMSE(plsda_pred)
Sen_pred <- plsda[["calres"]][["sensitivity"]] %>% as.data.frame()
Sen_pred <- data.frame(Sen=Sen_pred[1,9])
Sel_pred <- plsda[["calres"]][["specificity"]] %>% as.data.frame()
Sel_pred <- data.frame(Sel=Sel_pred[1,9])
#extraindo valores
RMSEP <- plsda_pred[["rmse"]] %>% t() %>%  as.data.frame()
RMSEP
PredR2 <- plsda_pred[["r2"]] %>%  t() %>%  as.data.frame()
PredR2
PredBias <- plsda_pred[["bias"]] %>%  t() %>%  as.data.frame()
#juntando todos os resultados em um unico data.frame
#Resumo
Resumo <- data.frame(VarExplX,
                     VarExplY,
                     CalR2, 
                     CVR2,
                     PredR2,
                     RMSEC,
                     RMSECV, 
                     RMSEP,
                     PredBias)
colnames(Resumo) <- c("Variancia Expl X",
                      "Variancia Expl Y",
                      "R² Cal", 
                      "R² CV", 
                      "R² Pred", 
                      "RMSEC", 
                      "RMSECV", 
                      "RMSEP", 
                      "Bias pred")
ypredresults <- plsda_pred[["y.pred"]] %>% as.data.frame()
ypredresults <- ypredresults[,9] %>% as.data.frame()
ypredresults$amostras <- row.names(Xpred)
colnames(ypredresults)[1] <- "Ypred"
ypredresults$amostras <- as.numeric(ypredresults$amostras)
ypredresults <- ypredresults[,c("amostras", "Ypred")]
#adicionando os valores de yreferencia em calresults
ypredref <- plsda_pred[["y.ref"]] %>% as.data.frame()
colnames(ypredref) <- "Yreferencia"
ypredresults <- data.frame(ypredresults, ypredref)
#plotando medido x previsto (pred)
Classe_pred <- Ypred#usando as classes de Ycal para rotular os pontos no grafico
ggplot(ypredresults, 
       aes(x=amostras, 
           y=Ypred)) +
  geom_point(aes(colour=Classe_pred, 
                 shape=Classe_pred), 
             size=4) +
  scale_shape_manual(values = c(8,20)) +
  scale_color_manual(values = c("red", "darkblue")) +
  geom_hline(yintercept = 0, 
             linetype="dashed", 
             color="green", 
             linewidth=1) +
  theme_classic( ) +
  theme(legend.position = "top", 
        text = element_text(size=18,
                            family = "serif"),
        axis.line = element_line(colour = "black"),
        axis.text.x = element_text(color = "black"), 
        axis.text.y = element_text(color = "black")) +
  labs(x="Amostras", 
       y= "Yprevisto - Pred")+
  scale_y_continuous(breaks=seq(-2, 1.5, 0.5))
ypredresults$classificacao <- ifelse(
  ypredresults$Ypred > 0 & ypredresults$Yreferencia == 1,
  "Verdadeiro Positivo - LV",
  ifelse(
    ypredresults$Ypred > 0 & ypredresults$Yreferencia == -1,
    "Falso Positivo - LV",
    ifelse(
      ypredresults$Ypred < 0 & ypredresults$Yreferencia == -1,
      "Verdadeiro Negativo - LV",
      ifelse(
        ypredresults$Ypred < 0 & ypredresults$Yreferencia == 1,
        "Falso Negativo - LV",
        NA # caso não se encaixe em nenhuma regra
      )
    )
  )
)
#extraindo valores de VP, FP, VN, FN
VP_pred <- plsda_pred[["tp"]] %>% as.data.frame()
VP_pred <- data.frame(VP=VP_pred[,9])
FP_pred <- plsda_pred[["fp"]] %>% as.data.frame()
FP_pred <- data.frame(FP=FP_pred[,9])
VN_pred <- plsda_pred[["tn"]] %>% as.data.frame()
VN_pred <- data.frame(VN=VN_pred[,9])
FN_pred <- plsda_pred[["fp"]] %>% as.data.frame()
FN_pred <- data.frame(FN=FN_pred[,9])
#matriz de confusao
getConfusionMatrix(plsda_pred)
Matriz_Conf_pred <- getConfusionMatrix(plsda_pred) %>% as.data.frame()
#Taxa de Falso Positivo (TFP)
TFP_pred <- (FP_pred*100)/(FP_pred+VN_pred)
TFP_pred
colnames(TFP_pred) <- "TFP"
#Taxa de Falso Negativo (TFN)
TFN_pred <- (FN_pred*100)/(FN_pred+VP_pred)
TFN_pred
colnames(TFN_pred) <- "TFN"
#Taxa de Confiabilidade (TCONF)
TCONF_pred <- 100-(TFP_pred+TFN_pred)
TCONF_pred
colnames(TCONF_pred) <- "TCONF"
#Resumo fom pred
Resumo_FOM_pred <- data.frame(VP_pred, 
                              VN_pred, 
                              FP_pred, 
                              FN_pred, 
                              Sen_pred, 
                              Sel_pred,
                              TFP_pred, 
                              TFN_pred, 
                              TCONF_pred)
write.xlsx(Resumo, "Resumo.xlsx")
write.xlsx(Resumo_FOM_cal, "Resumo_FOM_cal.xlsx")
write.xlsx(Resumo_FOM_pred, "Resumo_FOM_pred.xlsx")
write.xlsx(Matriz_Conf_Cal, "Matriz_Conf_Cal.xlsx")
write.xlsx(Matriz_Conf_pred, "Matriz_Conf_Pred.xlsx")
write.xlsx(vet_reg, "Vetor_de_Regressao.xlsx")
write.xlsx(VIPScores, "VIP_Scores.xlsx")
write.xlsx(ypredresults, "Valores de Y e Classificacao - predicao.xlsx")
write.xlsx(ycalresults, "Valores de Y e Classificacao - calibracao.xlsx")
library(openxlsx)
library(openxlsx)
write.xlsx(
  list(
    Resumo = Resumo,
    Resumo_FOM_cal = Resumo_FOM_cal,
    Resumo_FOM_pred = Resumo_FOM_pred,
    Matriz_Conf_Cal = Matriz_Conf_Cal,
    Matriz_Conf_Pred = Matriz_Conf_pred,
    Vetor_de_Regressao = vet_reg,
    VIP_Scores = VIPScores,
    Y_Predicao = ypredresults,
    Y_Calibracao = ycalresults
  ),
  "Resultados.xlsx"
)

