== Scatter por elemento
{% for i in range(bloco_completo.graficos_elementos | length) %}
{% set g1 = bloco_completo.graficos_elementos[i] %}
#figure(
  image("{{ g1.nome }}", width: 72%),
  caption: [{{ g1.elemento }} (completo). Arquivo: {{ g1.nome }}],
)
{% if i < (bloco_filtrado.graficos_elementos | length) %}
{% set g2 = bloco_filtrado.graficos_elementos[i] %}
#figure(
  image("{{ g2.nome }}", width: 72%),
  caption: [{{ g2.elemento }} (filtrado). Arquivo: {{ g2.nome }}],
)
{% endif %}
{% endfor %}

