{% macro tabela_typ(t, tamanho) %}
#text(size: {{ tamanho }}pt)[
  #table(
    columns: {{ t.colunas | length }},
    inset: 2.5pt,
    stroke: 0.4pt + luma(180),
    fill: (_, y) => if y == 0 { luma(225) } else if calc.odd(y) { luma(247) },
    table.header(
      {% for col in t.colunas %}{{ col | typ }},{% endfor %}
    ),
    {% for linha in t.linhas %}{% for v in linha %}{{ v | typ }},{% endfor %}
    {% endfor %}
  )
]
{% endmacro %}

